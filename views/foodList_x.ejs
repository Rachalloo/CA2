<!DOCTYPE html>
<html>
<head>
    <title>Pet Food</title>
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
<div class="container mt-5">
    <h1>Pet Food</h1>
    <a href="/pet-food/new" class="btn btn-success mb-3">+ Add Pet Food</a>

    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Name</th>
                <th>Category</th> <!-- Dry Food, Wet Food, Raw Diet -->
                <th>Brand</th>
                <th>Ingredients</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <% petFoods.forEach(food => { %>
                <tr>
                    <td><%= food.name %></td>
                    <td><%= food.category %></td>
                    <td><%= food.brand %></td>
                    <td><%= food.ingredients %></td>
                    <td>
                        <a href="/pet-food/edit/<%= food.id %>" class="btn btn-warning btn-sm">Edit</a>
                        <form action="/pet-food/delete/<%= food.id %>" method="POST" style="display:inline;">
                            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                        </form>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>
</div>
</body>
</html>
