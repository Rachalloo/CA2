<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Pet Food List</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
  <nav class="navbar navbar-expand-sm bg-dark navbar-dark">
    <div class="container-fluid">
      <a class="navbar-brand" href="/">Pet Council</a>
      <ul class="navbar-nav">
        <% if (user) { %>
          <li class="nav-item"><a class="nav-link" href="/addPetFood">+ Add Pet Food</a></li>
          <!-- Add more nav links if needed -->
        <% } %>
      </ul>
    </div>
  </nav>

  <div class="container mt-5">
    <h2 class="text-center mb-4">Pet Food List</h2>
    <table class="table table-bordered table-hover text-center align-middle">
      <thead class="table-dark">
        <tr>
          <th>Name</th>
          <th>Category</th>
          <th>Brand</th>
          <th>Ingredients</th>
          <th>Price ($)</th>
          <th>Quantity</th>
          <th>Image</th>
          <% if (user) { %>
            <th>Actions</th>
          <% } %>
        </tr>
      </thead>
      <tbody>
        <% if (petFoods.length > 0) { %>
          <% petFoods.forEach(food => { %>
            <tr>
              <td><%= food.name %></td>
              <td><%= food.category %></td>
              <td><%= food.brand %></td>
              <td><%= food.ingredients %></td>
              <td><%= food.price.toFixed(2) %></td>
              <td><%= food.quantity %></td>
              <td>
                <% if (food.image) { %>
                  <img src="/images/<%= food.image %>" alt="Pet Food Image" style="max-width: 80px;" />
                <% } else { %>
                  No image
                <% } %>
              </td>
              <% if (user) { %>
                <td>
                  <a href="/editPetFood/<%= food.id %>" class="btn btn-sm btn-primary">Edit</a>
                  <a href="/deletePetFood/<%= food.id %>" 
                     class="btn btn-sm btn-danger" 
                     onclick="return confirm('Are you sure you want to delete this item?');">Delete</a>
                </td>
              <% } %>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="<%= user ? 8 : 7 %>">No pet food items found.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</body>
</html>
