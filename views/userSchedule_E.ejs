<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pet Council - My Schedule</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
  <style>
    .badge-vet { background-color: #198754; }
    .badge-grooming { background-color: #0d6efd; }
    .badge-hotel { background-color: #fd7e14; }
  </style>
</head>

<body>
  <div class="container mt-5">
    <div class="text-center mb-4">
      <h2 class="fw-bold">My Pet Appointments</h2>
      <p class="text-muted">Welcome, <strong><%= user.username %></strong> (<%= user.role %>)</p>
    </div>

    <% if (appointments.length === 0) { %>
      <div class="alert alert-info text-center">No appointments found.</div>
    <% } else { %>
      <div class="row row-cols-1 row-cols-md-2 g-4">
        <% appointments.forEach(item => { %>
          <div class="col">
            <div class="card appointment-card border-0 shadow-sm">
              <div class="card-body">
                <h5 class="card-title d-flex align-items-center">
                  <% if (item.type === 'Vet') { %>
                    <span class="badge badge-vet me-2">Vet</span>
                  <% } else if (item.type === 'Grooming') { %>
                    <span class="badge badge-grooming me-2">Grooming</span>
                  <% } else { %>
                    <span class="badge badge-hotel me-2">Hotel</span>
                  <% } %>
                  <%= item.title %>
                </h5>
                <ul class="list-group list-group-flush mt-3">
                  <li class="list-group-item">
                    <i class="bi bi-calendar-event me-2 text-primary"></i>
                    Date: <%= item.appointmentDate %>
                  </li>
                  <li class="list-group-item">
                    <i class="bi bi-clock me-2 text-warning"></i>
                    Time: <%= item.time || 'Not Available' %>
                  </li>
                  <li class="list-group-item">
                    <i class="bi bi-paw me-2 text-success"></i>
                    Pet Name: <%= item.petName || 'Not Available' %>
                  </li>
                  <li class="list-group-item">
                    <i class="bi bi-heart-pulse me-2 text-danger"></i>
                    Breed: <%= item.petBreed || 'Not Available' %>
                  </li>
                </ul>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>
</body>

</html>
