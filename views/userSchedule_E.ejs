<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pet Council - My Schedule</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</head>

<body>
  <!-- You can add your navbar here -->

  <div class="container mt-4">
    <h3>Welcome, <%= user.name %> (<%= user.role %>)</h3>
    <hr>

    <h2 class="text-center mb-4">My Pet Appointments</h2>

    <div class="table-responsive">
      <table class="table table-bordered table-striped align-middle text-center">
        <thead class="table-dark">
          <tr>
            <th>Type</th>
            <th>Title / Reason</th>
            <th>Date</th>
            <th>Time</th>
            <th>Pet Name</th>
            <th>Pet Breed</th>
          </tr>
        </thead>
        <tbody>
          <% appointments.forEach(item => { %>
            <tr>
              <td><%= item.type %></td>
              <td><%= item.title %></td>
              <td><%= item.appointmentDate %></td>
              <td><%= item.time || 'Not Available' %></td>
              <td><%= item.petName || 'Not Available' %></td>
              <td><%= item.petBreed || 'Not Available' %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</body>

</html>

