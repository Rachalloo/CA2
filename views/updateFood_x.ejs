<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Update Pet Food</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
  <nav class="navbar navbar-expand-sm bg-dark navbar-dark">
    <div class="container-fluid">
      <a class="navbar-brand" href="/petFoodList">Pet Products</a>
      <ul class="navbar-nav">
        <li class="nav-item"><a class="nav-link" href="/addPetFood">+ Add New Food</a></li>
        <li class="nav-item"><a class="nav-link" href="/petFoodList">Back to Food List</a></li>
      </ul>
    </div>
  </nav>

  <div class="container mt-5">
    <h2 class="text-center mb-4">Update Pet Food</h2>

    <% if (food) { %>
      <form action="/editPetFood/<%= food.id %>" method="POST" enctype="multipart/form-data" class="mx-auto" style="max-width: 600px;">
        <div class="mb-3">
          <label for="name" class="form-label">Food Name</label>
          <input type="text" id="name" name="name" class="form-control" value="<%= food.name %>" required />
        </div>

        <div class="mb-3">
          <label for="category" class="form-label">Category</label>
          <select id="category" name="category" class="form-control" required>
            <option value="">-- Select Type --</option>
            <option value="Dry Food" <%= food.category === 'Dry Food' ? 'selected' : '' %>>Dry Food</option>
            <option value="Wet Food" <%= food.category === 'Wet Food' ? 'selected' : '' %>>Wet Food</option>
            <option value="Treats" <%= food.category === 'Treats' ? 'selected' : '' %>>Treats</option>
          </select>
        </div>

        <div class="mb-3">
          <label for="brand" class="form-label">Brand</label>
          <input type="text" id="brand" name="brand" class="form-control" value="<%= food.brand %>" required />
        </div>

        <div class="mb-3">
          <label for="ingredients" class="form-label">Ingredients</label>
          <textarea id="ingredients" name="ingredients" class="form-control" rows="3" required><%= food.ingredients %></textarea>
        </div>

        <div class="mb-3">
          <label for="price" class="form-label">Price ($)</label>
          <input type="number" id="price" name="price" class="form-control" step="0.01" min="0" value="<%= food.price %>" required />
        </div>

        <div class="mb-3">
          <label for="quantity" class="form-label">Quantity</label>
          <input type="number" id="quantity" name="quantity" class="form-control" min="0" value="<%= food.quantity %>" required />
        </div>

        <div class="mb-3">
          <label class="form-label">Current Image</label>
          <input type="text" name="currentImage" class="form-control" value="<%= food.image %>" readonly />
          <% if (food.image) { %>
            <div class="mt-2">
              <img src="/images/<%= food.image %>" alt="Current Image" class="img-thumbnail" style="max-width: 200px;" />
            </div>
          <% } else { %>
            <div class="mt-2 text-muted">No image available.</div>
          <% } %>
        </div>

        <div class="mb-3">
          <label for="image" class="form-label">New Image (optional)</label>
          <input type="file" id="image" name="image" class="form-control" accept="image/*" />
        </div>

        <div class="text-center">
          <button type="submit" class="btn btn-primary">Update Food</button>
          <a href="/petFoodList" class="btn btn-secondary ms-2">Cancel</a>
        </div>
      </form>
    <% } else { %>
      <div class="alert alert-warning text-center">No food item found.</div>
      <div class="text-center">
        <a href="/petFoodList" class="btn btn-secondary">Back</a>
      </div>
    <% } %>
  </div>
</body>
</html>
