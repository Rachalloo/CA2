<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <title>Pet Hotel</title>
</head>
<body>
    <nav class="navbar navbar-expand-sm bg-dark navbar-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="/petHotel">Pet Hotel</a>
        </div>
    </nav>
    <div class="container">
      <br>
      <div class="text-center">
        <h2>Pet Hotel</h2>
      </div>
      <br>
      <table class="table table-hover small text-center">
        <thead>
          <tr>
            <th width="150">Customer Name</th>
            <th width="150">Pet Name</th>
            <th width="100">Pet Image</th>
            <th width="100">Start Date</th>
            <th width="100">End Date</th>
            <th width="100">Edit</th>
            <th width="100">Delete</th>
          </tr>
        </thead>
        <tbody>
          <% for(let i=0; i < pet.length; i++) { %>
            <tr>
              <td>
                <%= pet[i].customer_name %>
              </td>
              <td>
                <%= pet[i].pet_name %>
              </td>
              <td><img src="images/<%= pet[i].image %>" width="20%"></td>
              <td>
                <%= pet[i].start_date %>
              </td>
              <td>
                <%= pet[i].end_date %>
              </td>
              <!--edit link-->
              <td><a href="/editPet/ <%= pet[i].id %>">Edit</a></td>
              <!--delete link-->
              <td><a href="/deletePet/ <%= pet[i].id %>" style="color: red;"
                  onclick="return confirm('Are you sure you want to delete this pet?')">Delete</a></td>
            </tr>
            <% } %>
        </tbody>
      </table>
    </div>
</body>
</html>
