<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <title>Pet Hotel</title>
</head>

<body>
  <div class="container">
    <br>
    <div class="text-center">
      <h2>Pets from Pet Hotel Database</h2>
    </div>
    <br>

    <table class="table table-hover small text-center">
      <thead>
        <tr>
          <th width="100">User Name</th>
          <th width="100">Pet Name</th>
          <th width="150">Pet Image</th>
          <th width="100">Start Date</th>
          <th width="100">End Date</th>
          <th width="100">Edit</th>
          <th width="100">Delete</th>
        </tr>
      </thead>
      <tbody>
        <% for(let i=0; i < pets.length; i++) { %>
          <tr>
            <td>
              <%= pets[i].user %>
            </td>
            <td>
              <%= pets[i].petName %>
            </td>
            <td><img src="images/<%=pets[i].image %>" width="20%"></td>
            <td>
              <%= pets[i].startDate %>
            </td>
            <td><%= pets[i].endDate %>
            </td>
            <!--edit link-->
            <td><a href="/editPet/ <%= pets[i].petId %>">Edit</a></td>
            <!--delete link-->
            <td><a href="/deletePet/ <%= pets[i].petId %>"
                onclick="return confirm('Are you sure you want to delete this pet?')">Delete</a></td>
          </tr>
          <% } %>
      </tbody>
    </table>
  </div>

<p class="mx-auto p-2"><a class="btn btn-light btn-sm" href="/Home" role="button">Back to Home</a></p>

<!-- Footer -->
<footer class="bg-dark text-white text-center py-3 mt-5">
  <p>&copy; 2025 Pet Council. All rights reserved.</p>
</footer>

</body>

</html>
