<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Appointment</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body>

<div class="container mt-5">
  <h1 class="text-center">Pet Appointment Form</h1>

  <form action="/appt_form_create_SRD" method="POST" class="mt-4">
    <div class="mb-3">
        <label for="appointment">Choose an Appointment:</label>
        <select name="appointment" id="appointment">
            <option value="Grooming Appointment">Grooming Appointment</option>
            <option value="Vet Appointment">Vet Appointment</option>
            <option value="Pet Hotel">Pet Hotel</option>
        </select>
    </div>

    <br><br>

      <label>Name</label>
      <input type="text" name="name" class="form-control" required />
    </div>

    <div class="mb-3">
      <label>Contact Number</label>
      <input type="tel" name="contact" class="form-control" required />
    </div>

    <div class="mb-3">
      <label>Email</label>
      <input type="email" name="email" class="form-control" required />
    </div>

    <div class="mb-3">
      <label>Preferred Grooming Date</label>
      <input type="date" name="date" class="form-control" required />
    </div>

    <div class="mb-3">
      <label>Preferred Time Slot</label>
      <input type="text" name="time" class="form-control" placeholder="e.g. 10am - 12pm" required />
    </div>

    <div class="mb-3">
      <label>First Time Customer?</label>
      <select name="firstTime" class="form-control" required>
        <option value="Yes">Yes</option>
        <option value="No">No</option>
      </select>
    </div>

    <div class="mb-3">
      <label>Preferred Groomer Name (Optional)</label>
      <input type="text" name="groomer" class="form-control" />
    </div>

    <div class="mb-3">
      <label>Pet Name</label>
      <input type="text" name="petName" class="form-control" required />
    </div>

    <div class="mb-3">
      <label>Pet Breed</label>
      <input type="text" name="petBreed" class="form-control" required />
    </div>

    <div class="mb-3">
      <label>Pet Information</label>
      <textarea name="petInfo" class="form-control" required></textarea>
    </div>

    <div class="mb-3">
      <label>Pet Age</label>
      <input type="number" name="petAge" class="form-control" required />
    </div>

    <div class="mb-3">
      <label>Pet Health Condition (If Any)</label>
      <textarea name="petHealth" class="form-control"></textarea>
    </div>

    <div class="mb-3">
      <label>Description</label>
      <textarea name="description" class="form-control" required></textarea>
    </div>

    <div class="form-check mb-4">
      <input class="form-check-input" type="checkbox" required>
      <label class="form-check-label">
        I agree to the <a href="#">privacy policy</a>.
      </label>
    </div>

    <button type="submit" class="btn btn-success">Submit Appointment</button>
    <button type="reset" class="btn btn-secondary ms-2">Clear</button>
  </form>

  <!-- Decorative pet picture -->
  <div class="text-center mt-5">
    <img src="https://tse3.mm.bing.net/th/id/OIP.gwmMot1o-z5maenRor2kqQHaE8?rs=1&pid=ImgDetMain&o=7&rm=3" class="img-fluid rounded" alt="Happy Pet">
  </div>
</div>

</body>
</html>
