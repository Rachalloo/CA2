<!DOCTYPE html>
<html>
<head>
    <title>Medications</title>
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
<div class="container mt-5">
    <h1>Medications</h1>
    <a href="/medications/add" class="btn btn-success mb-3">Add Medication</a>

    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Name</th>
                <th>Dosage</th>
                <th>Instructions</th>
                <th>Licensed</th>
                <th>Edit/Delete</th>
            </tr>
        </thead>
        <tbody>
            <% medications.forEach(medication => { %>
                <tr>
                    <td><%= medication.medication_name %></td>
                    <td><%= medication.medication_dosage %></td>
                    <td><%= medication.medication_instructions %></td>
                    <td><%= medication.medication_licensed %></td>
                    <td>
                        <a href="/medications/edit/<%= medication.medication_id %>" class="btn btn-warning btn-sm">Edit</a>
                        <form action="/medications/delete/<%= medication.medication_id %>" method="POST" style="display:inline;">
                            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                        </form>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>
</div>
</body>
</html>
