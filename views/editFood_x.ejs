<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Pet Food</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</head>

<body>
  <nav class="navbar navbar-expand-sm bg-dark navbar-dark">
    <div class="container-fluid">
      <a class="navbar-brand" href="/petFoodList">Pet Hotel</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#collapsibleNavbar">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="collapsibleNavbar">
        <ul class="navbar-nav">
          <li class="nav-item">
            <a class="nav-link" href="/addPetFood">Add New Food</a>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <div class="container mt-5">
    <h2 class="text-center mb-4">Update Pet Food</h2>

    <% if (food) { %>
      <form action="/editPetFood/<%= food.foodId %>" method="POST" enctype="multipart/form-data" class="mx-auto" style="max-width: 600px;">
        <div class="mb-3">
          <label for="name" class="form-label">Food Name</label>
          <input type="text" id="name" name="name" class="form-control" value="<%= food.name %>" required>
        </div>

        <div class="mb-3">
          <label for="category" class="form-label">Category</label>
          <input type="text" id="category" name="category" class="form-control" value="<%= food.category %>" required>
        </div>

        <div class="mb-3">
          <label for="brand" class="form-label">Brand</label>
          <input type="text" id="brand" name="brand" class="form-control" value="<%= food.brand %>" required>
        </div>

        <div class="mb-3">
          <label for="ingredients" class="form-label">Ingredients</label>
          <textarea id="ingredients" name="ingredients" class="form-control" rows="3" required><%= food.ingredients %></textarea>
        </div>

        <div class="mb-3">
          <label class="form-label">Current Image</label>
          <input type="text" name="currentImage" class="form-control" value="<%= food.image %>" readonly>
          <div class="mt-2">
            <img src="/images/<%= food.image %>" class="img-thumbnail" style="max-width: 200px;">
          </div>
        </div>

        <div class="mb-3">
          <label for="image" class="form-label">New Image (optional)</label>
          <input type="file" id="image" name="image" class="form-control" accept="image/*">
        </div>

        <div class="text-center">
          <button type="submit" class="btn btn-primary">Update Food</button>
          <a href="/petFoodList" class="btn btn-secondary ms-2">Cancel</a>
        </div>
      </form>
    <% } else { %>
      <div class="alert alert-warning text-center">No food item found.</div>
      <div class="text-center">
        <a href="/petFoodList" class="btn btn-secondary">Back</a>
      </div>
    <% } %>
  </div>
</body>
</html>
