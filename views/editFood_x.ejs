<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Edit Pet Food</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
</head>
<body>
  <nav class="navbar navbar-expand-sm bg-dark navbar-dark">
    <div class="container-fluid">
      <a class="navbar-brand" href="/petFoodList">Pet Products</a>
      <ul class="navbar-nav">
        <li class="nav-item"><a class="nav-link" href="/addPetFood">+ Add New Food</a></li>
        <li class="nav-item"><a class="nav-link" href="/petFoodList">Back to Food List</a></li>
      </ul>
    </div>
  </nav>

  <div class="container mt-5">
    <h2 class="text-center mb-4">Update Pet Food</h2>
    <% if (food) { %>
      <form action="/editPetFood/<%= food.id %>" method="POST" enctype="multipart/form-data" class="mx-auto" style="max-width: 600px;">
        <div class="mb-3">
          <label for="food_name" class="form-label">Food Name</label>
          <input type="text" id="food_name" name="food_name" class="form-control" value="<%= food.food_name %>" required>
        </div>

        <div class="mb-3">
          <label for="food_category" class="form-label">Category</label>
          <select id="food_category" name="food_category" class="form-select" required>
            <option value="">-- Select Category --</option>
            <option value="Dry food" <%= food.food_category === 'Dry food' ? 'selected' : '' %>>Dry Food</option>
            <option value="Wet food" <%= food.food_category === 'Wet food' ? 'selected' : '' %>>Wet Food</option>
            <option value="Treat" <%= food.food_category === 'Treat' ? 'selected' : '' %>>Treat</option>
          </select>
        </div>

        <div class="mb-3">
          <label for="food_brand" class="form-label">Brand</label>
          <input type="text" id="food_brand" name="food_brand" class="form-control" value="<%= food.food_brand %>" required>
        </div>

        <div class="mb-3">
          <label for="food_description" class="form-label">Description</label>
          <textarea id="food_description" name="food_description" class="form-control" rows="3" required><%= food.food_description %></textarea>
        </div>

        <div class="mb-3">
          <label for="food_price" class="form-label">Price ($)</label>
          <input type="number" id="food_price" name="food_price" class="form-control" step="0.01" min="0" value="<%= food.food_price %>" required>
        </div>

        <div class="mb-3">
          <label for="food_quantity" class="form-label">Quantity</label>
          <input type="number" id="food_quantity" name="food_quantity" class="form-control" min="0" value="<%= food.food_quantity %>" required>
        </div>

        <div class="mb-3">
          <label class="form-label">Current Image</label>
          <input type="text" name="currentImage" class="form-control" value="<%= food.image %>" readonly>
  
      <div class="mb-3">
        <label class="form-label">Current Image</label>
        <input type="text" name="currentImage" class="form-control" value="<%= food.image %>" readonly>

        <% if (food.image) { %>
      <div class="mt-2">
        <img src="/images/<%= food.image %>" alt="Current Image" class="img-thumbnail" style="max-width: 200px;">
      </div>
        <% } else { %>
        <div class="mt-2 text-muted">No image available.</div>
      <% } %>
      </div>



        <div class="mb-3">
          <label for="image" class="form-label">New Image (optional)</label>
          <input type="file" id="image" name="image" class="form-control" accept="image/*">
        </div>

        <div class="text-center">
          <button type="submit" class="btn btn-primary">Update Food</button>
          <a href="/petFoodList" class="btn btn-secondary ms-2">Cancel</a>
        </div>
      </form>
    <% } else { %>
      <div class="alert alert-warning text-center">No food item found.</div>
      <div class="text-center">
        <a href="/petFoodList" class="btn btn-secondary">Back</a>
      </div>
    <% } %>
  </div>
</body>
</html>
