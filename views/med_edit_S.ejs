<!DOCTYPE html>
<html>
<head>
    <title>Edit Medication</title>
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div class="container mt-5">
        <h1>Edit Medication</h1>

        <form action="/medications/edit/<%= medication.id %>" method="POST" class="mt-4">

            <div class="form-group">
                <label for="medication_name">Medication Name:</label>
                <input type="text" id="medication_name" name="medication_name" class="form-control" value="<%= medication.medication_name %>" required>
            </div>

            <div class="form-group">
                <label for="dosage">Dosage:</label>
                <input type="text" id="dosage" name="dosage" class="form-control" value="<%= medication.dosage %>" required>
            </div>

            <div class="form-group">
                <label for="instructions">Instructions:</label>
                <textarea id="instructions" name="instructions" class="form-control" required><%= medication.instructions %></textarea>
            </div>

            <div class="form-group">
                <label for="licensed">Licensed:</label>
                <select id="licensed" name="licensed" class="form-control">
                    <option value="Yes" <%= medication.licensed === 'Yes' ? 'selected' : '' %>>Yes</option>
                    <option value="No" <%= medication.licensed === 'No' ? 'selected' : '' %>>No</option>
                </select>
            </div>

            <button type="submit" class="btn btn-success">Update Medication</button>
            <a href="/medications" class="btn btn-secondary ml-2">Cancel</a>
        </form>
    </div>
</body>
</html>
