<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <title>Pet Council</title>
</head>

<body>
  <!-- add navbar here -->

  <!-- Main Content -->
  <div class="container mt-4">
    <h2 class="text-center mb-4">Request for Re-schedule Deletion</h2>
    <form action="/user_schedule_reschedule-request/<%= appointment.appointmentId %>" method="POST"
      enctype="multipart/form-data" class="mx-auto" style="max-width: 500px;">

      <h2>Item Name: <%= appointment.appointmentName %></h2>

      <div class="mb-3">
        <label for="appointmentDate" class="form-label">New Start Date:</label>
        <input type="date" class="form-control" id="appointmentDate" name="appointmentDate" required>
      </div>

      <div class="d-grid">
        <button type="submit" class="btn btn-primary">Request for Reschedule</button>
      </div>

    </form>
  </div>
</body>

</html>
