<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <title>Pet Hotel</title>
</head>

<body>
  <div class="container">
    <br>
    <div class="text-center">
      <h2>Pet Details</h2>
    </div>
    <br>
    <% if (pets) { %> <!--check if pet data exists-->
      <div>
        <p><b>User Name:</b><br>
          <%= pets.user %>
        </p>
        <p><b>Pet Name:</b><br>
          <%= pets.petName %>
        </p>
        <p><b>Pet Image:</b><br> <img src="<%= pets.image %>" width="20%"></p>
        <p><b>Start Date:</b><br>
          <%= pets.startDate %>
        </p>
        <p><b>End Date:</b><br> <%= pets.endDate %>
        </p>
      </div>
      <% } else { %>
        <p>No pet found.</p>
        <% } %>
          <a href="/petDetails">Back</a>
  </div>

<!-- Footer -->
<footer class="bg-dark text-white text-center py-3 mt-5">
  <p>&copy; 2025 Pet Council. All rights reserved.</p>
</footer>

</body>

</html>
