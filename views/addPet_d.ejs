<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <title>Pet Hotel</title>
</head>

<body>

  <div class="container">
    <br>
    <div class="text-center">
      <h2>Add New Pet</h2>
    </div>
    <br>
    <div class="text-center">
      <form action="/addPet" method="POST" enctype="multipart/form-data">
        <label for="user">User Name:</label><br>
        <input type="text" id="user" name="user" required><br><br>

        <label for="pet">Pet Name:</label><br>
        <input type="text" id="pet" name="pet" required><br><br>

        <label for="startdate">Start Date:</label><br>
        <input type="date" id="startdate" name="startdate" required><br><br>

        <label for="enddate">End Date:</label><br>
        <input type="date" id="enddate" name="enddate" required><br><br>

        <label for="image">Image:</label><br>
        <input type="file" id="image" name="image" accept="image/*" required><br><br>

        <button type="submit">Add Pet</button>
      </form>
    </div>
  </div>

<!-- Footer -->
<footer class="bg-dark text-white text-center py-3 mt-5">
  <p>&copy; 2025 Pet Council. All rights reserved.</p>
</footer>

</body>

</html>
