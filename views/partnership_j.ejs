<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Partnerships</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</head>

<body>

    <nav class="navbar navbar-expand-sm bg-dark navbar-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="/">Pet Council Pharmacy</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navMenu">
                <ul class="navbar-nav">
                    <% if (user && user.role==='admin' ) { %>
                        <li class="nav-item">
                            <a class="nav-link" href="/addPartnership">Add Partnership</a>
                        </li>
                        <% } %>
                            <li class="nav-item">
                                <a class="nav-link" href="/">Back</a>
                            </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-5">
        <div class="text-center mb-4">
            <h2>All Partnerships</h2>
        </div>

        <div class="row">
            <% if (partnerships && partnerships.length> 0) { %>
                <% partnerships.forEach(partnership=> { %>
                    <div class="col-md-4 mb-4">
                        <div class="card h-100">
                            <% if (partnership.image) { %>
                                <img src="/Pictures/<%= partnership.image %>"class="card-img-top" alt="Partnership Image" />
                            <% } %>
                            <div class="card-body">
                                <p>Name:<br><%= partnership.name %></p>
                                <p>Contact:<br><%= partnership.contact %></p>
                                <p>Email:<br><%= partnership.email %></p>
                            </div>
                            <% if (user && user.role==='admin' ) { %>
                                <div class="card-footer text-center">
                                    <a href="/editPartnership/<%= partnership.partnershipId %>">Edit</a>
                                    <a href="/deletePartnership/<%= partnership.partnershipId %>"
                                        onclick="return confirm('Are you sure you want to delete this partnership?')">
                                        Delete
                                    </a>
                                </div>
                            <% } %>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <p>No partnership found.</p>
            <% } %>
        </div>
    </div>
</body>
</html>
