<!-- Picture and Welcome -->
<div class="container text-center mt-4">
  <img src="https://images.pexels.com/photos/1056251/pexels-photo-1056251.jpeg?cs=srgb&dl=pexels-ihsanaditya-1056251.jpg&fm=jpg" alt="Cat Pictures" class="img-fluid rounded">
  <h1 class="display-4 mt-3">Welcome to Pet Council Grooming Centre</h1>
