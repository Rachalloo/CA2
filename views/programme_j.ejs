<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Programmes</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body>

<nav class="navbar navbar-expand-sm bg-dark navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="/">Pet Council Pharmacy</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navMenu">
            <ul class="navbar-nav">
                <% if (user && user.role === 'admin') { %>
                    <li class="nav-item">
                        <a class="nav-link" href="/programmes/add">Add Programme</a>
                    </li>
                <% } %>
                <li class="nav-item">
                    <a class="nav-link" href="/index_j">Back</a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<div class="container mt-5">
    <div class="text-center mb-4">
        <h2>All Programmes</h2>
    </div>

    <div class="row">
        <% if (programmes && programmes.length > 0) { %>
            <% programmes.forEach(programme => { %>
                <div class="col-md-4 mb-4">
                    <div class="card h-100">
                        <% if (programme.image) { %>
                            <img src="<%= programme.image %>" class="card-img-top" alt="Programme Image">
                        <% } %>
                        <div class="card-body">
                            <p>Description:<br><%= programme.description %></p>
                            <p>Start Date:<br><%= programme.startDate %></p>
                            <p>End Date:<br><%= programme.endDate %></p>
                            <p>Location:<br><%= programme.location %></p>
                        </div>
                        <% if (user && user.role === 'admin') { %>
                            <div class="card-footer text-center">
                                <a href="/programme/edit/<%= prog.id %>">Edit</a>
                                <form action="/programme/delete/<%= prog.id %>" method="POST" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-primary me-2"
                                        onclick="return confirm('Are you sure you want to delete this programme?')">
                                        Delete
                                    </button>
                                </form>
                            </div>
                        <% } %>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <p>No programme found.</p>
        <% } %>
    </div>
</div>

</body>
</html>
