<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <title>Pet Hotel</title>
</head>

<body>
   <%- include ('header_E.ejs') %>

  <div class="container">
    <br>
    <div class="text-center">
      <h2>Update Pet</h2>
    </div>
    <br>
    <div class="text-center">
      <% if (pets) { %>
        <form action="/editPet/<%= pets.petId %>" method="POST" enctype="multipart/form-data">
          <label for="name">Pet Name:</label><br>
          <input type="text" id="name" name="name" value="<%= pets.petName %>" required><br><br>

          <label for="startdate">Start Date:</label><br>
          <input type="date" id="startdate" name="startdate" value=<%=pets.startDate %> required><br><br>

          <label for="enddate">End Date:</label><br>
          <input type="date" id="enddate" name="enddate" value=<%=pets.endDate %> required><br><br>

          <label for="image">Current Image:</label><br>
          <input type="text" name="currentImage" value=<%=pets.image%> readonly><br>
          <img src="/images/<%= pets.image %>" width="20%"><br><br>

          New Image:<br> <input type="file" id="image" name="image" accept="image/*" value=<%=pets.image %>><br><br>

          <button type="submit">Update Pet</button>
        </form>
        <% } else { %>
          <p>No pet found.</p>
          <% } %>
            <a href="/petDetails">Back</a>
    </div>
  </div>

<!-- Footer -->
<footer class="bg-dark text-white text-center py-3 mt-5">
  <p>&copy; 2025 Pet Council. All rights reserved.</p>
</footer>

</body>

</html>
