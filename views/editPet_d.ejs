<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <title>Pet Hotel</title>
</head>
<body>
  
  <div class="container">
    <br>
    <div class="text-center">
      <h2>Update Pet</h2>
    </div>
    <br>
    <div class="text-center">
      <% if (pet) { %>
        <form action="/editPet/<%= pet.id %>" method="POST" enctype="multipart/form-data">
          <label for="customer_name">Customer Name:</label><br>
          <input type="text" id="customer_name" name="customer_name" value="<%= pet.customer_name %>" required><br><br>

          <label for="pet_name">Pet Name:</label><br>
          <input type="text" id="pet_name" name="pet_name" value="<%= pet.pet_name %>" required><br><br>

          <label for="start_date">Start Date:</label><br>
          <input type="date" id="start_date" name="start_date" value=<%=pet.start_date %> required><br><br>

          <label for="end_date">End Date:</label><br>
          <input type="date" id="end_date" name="end_date" value=<%=pet.end_date %> required><br><br>

          <label for="image">Current Image:</label><br>
          <input type="text" name="currentImage" value=<%=pet.image%> readonly><br><br>
          <img src="/images/<%= pet.image %>" width="20%"><br><br>

          New Image:<br> <input type="file" id="image" name="image" accept="image/*" value=<%=pet.image %>><br><br>

          <button type="submit">Update Pet</button>
        </form>
        <% } else { %>
          <p>No pet found</p>
          <% } %>
            <a href="/petHotel">Back</a>
    </div>
  </div>
</body>
</html>