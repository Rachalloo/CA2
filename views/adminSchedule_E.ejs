<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Admin Schedule</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <div class="container mt-4">
    <h2 class="text-center mb-4">All Appointments</h2>
    <p>Welcome, <%= user.name %> (Admin)</p>

    <div class="row">
      <% if (appointments.length === 0) { %>
        <p>No appointments found.</p>
      <% } %>

      <% appointments.forEach(appointment => { %>
        <div class="col-md-4 mb-3">
          <div class="card">
            <div class="card-body">
              <h5 class="card-title"><%= appointment.type %> Appointment</h5>
              <h6 class="card-subtitle mb-2 text-muted"><%= appointment.appointmentDate %> <% if (appointment.time) { %> at <%= appointment.time %> <% } %></h6>
              <p class="card-text">
                <strong>Service:</strong> <%= appointment.title %><br>
                <strong>Pet:</strong> <%= appointment.petName %> <% if (appointment.petBreed) { %> (<%= appointment.petBreed %>) <% } %><br>
                <strong>With:</strong> <%= appointment.name %><br>
              </p>

              <% if (appointment.type === 'Grooming') { %>
                <a href="/admin_schedule_review-reschedule/<%= appointment.id %>" class="btn btn-sm btn-outline-primary">Update</a>
                <form action="/admin_schedule_deleteSchedule/<%= appointment.id %>" method="POST" onsubmit="return confirm('Delete this grooming appointment?')" class="d-inline">
                  <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                </form>
              <% } else if (appointment.type === 'Vet') { %>
                <!-- Optional admin actions for vet appointments -->
                <form action="/admin_appointments_delete/<%= appointment.id %>" method="POST" onsubmit="return confirm('Delete this vet appointment?')" class="d-inline">
                  <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                </form>
              <% } %>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
  <div>
  <a href="/Home" class="btn btn-primary">Back to Home</a>
</div>

<!-- Footer -->
<%- include ('footer_R') %>
</body>
</html>