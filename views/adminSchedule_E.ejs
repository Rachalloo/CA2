<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <title>Pet Council</title>
</head>

<body>
  <!-- add navbar here -->

  <div class="container">
    <p>Welcome, <%= user.name %> (<%= user.role %>)</p>
    <br>
    <div class="text-center">
      <h2>Current Schedule</h2>
    </div>
    <br>
    <div class="row">
      <% appointments.forEach(appointment=> { %>
        <div class="col-md-4 mb-3">
          <div class="card" style="width: 18rem;">
            <div class="card-body">
              <h5 class="card-title">
                <%= appointment.appointmentName %>
              </h5>
              <h6 class="card-subtitle mb-2 text-body-secondary">
                <%= appointment.appointmentDate %>
              </h6>
              <a href="/admin/schedule/review-reschedule/<%= appointment.appointmentId %>" class="card-link">Approve & Update</a>
              <a href="/admin/schedule/deleteSchedule/<%= appointment.appointmentId %>" class="card-link"
                onclick="return confirm('Are you sure you want to delete this schedule item?')">Delete</a>
            </div>
          </div>
        </div>
        <% }); %>
    </div>
  </div>
</body>

</html>
