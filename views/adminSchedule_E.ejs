<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Admin Schedule</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
  <div class="container mt-4">
    <p>Welcome, <%= user.name %> (<%= user.role %>)</p>
    <h2 class="mb-4 text-center">All Appointments & Bookings</h2>
    
    <div class="row">
      <% if (appointments.length === 0) { %>
        <p class="text-center">No appointments or bookings found.</p>
      <% } %>

      <% appointments.forEach(function(appointment) { %>
        <div class="col-md-4 mb-3">
          <div class="card h-100 border-primary">
            <div class="card-body">
              <h5 class="card-title">
                <%= appointment.type %>: <%= appointment.title %>
              </h5>
              <h6 class="card-subtitle mb-2 text-muted">
                Date: <%= new Date(appointment.appointmentDate).toLocaleDateString() %>
              </h6>
              <% if (appointment.time) { %>
                <p class="card-text">Time: <%= appointment.time %></p>
              <% } %>
              <% if (appointment.petName) { %>
                <p class="card-text">Pet Name: <%= appointment.petName %></p>
              <% } %>
              <% if (appointment.petBreed) { %>
                <p class="card-text">Pet Breed: <%= appointment.petBreed %></p>
              <% } %>
              <% if (appointment.name) { %>
                <p class="card-text">Owner/Customer: <%= appointment.name %></p>
              <% } %>
            </div>
            <div class="card-footer text-end">
              <!-- Example admin controls (edit/delete) -->
              <a href="/admin_schedule_review-reschedule/<%= appointment.id %>" class="btn btn-sm btn-warning me-2">Review/Reschedule</a>
              <% if (appointment.type === "Vet") { %>
                <form action="/admin_appointments_delete/<%= appointment.id %>" method="POST" style="display:inline;" onsubmit="return confirm('Delete this appointment?');">
                  <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                </form>
              <% } %>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  </div>
</body>
</html>

  <div>
  <a href="/Home" class="btn btn-primary">Back to Home</a>
</div>

<!-- Footer -->
<%- include ('footer_R') %>
</body>
</html>
