<!DOCTYPE html>
<html>
<head>
    <title>Vet Appointments</title>
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div class="container">
        <h1 class="mt-5">Admin Dashboard</h1>
        <p>Welcome, <%= user?.username %></p>
        <a href="/logout" class="btn btn-primary">Logout</a>

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2>Vet Appointments</h2>
            <a href="/appointments/new" class="btn btn-success">New Appointment</a>
        </div>

        <table class="table table-bordered table-striped">
            <thead class="thead-dark">
                <tr>
                    <th>Pet</th>
                    <th>Vet</th>
                    <th>Date</th>
                    <th>Reason</th>
                    <th>Status</th>
                    <th>Edit/Delete</th>
                </tr>
            </thead>

            <tbody>
                <% appointments.forEach(appt => { %>
                    <tr>
                        <td><%= appt.pet_name %></td>
                        <td><%= appt.vet_name %></td>
                        <td><%= appt.appointment_date.toLocaleString() %></td>
                        <td><%= appt.reason %></td>
                        <td><%= appt.status %></td>
                        <td>
                            <a href="/appointments/edit/<%= appt.id %>" class="btn btn-sm btn-warning">Edit</a>
                            <a href="/appointments/delete/<%= appt.id %>" class="btn btn-sm btn-danger" onclick="return confirm('Delete this appointment?')">Delete</a>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</body>
</html>
