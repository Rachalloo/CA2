<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Edit Programme</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>

<body>

    <nav class="navbar navbar-expand-sm bg-dark navbar-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="/">Pet Council Pharmacy</a>
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" href="/programme">Back to Programme</a>
                </li>
            </ul>
        </div>
    </nav>

    <div class="container mt-5">
        <h2 class="text-center mb-4">Edit Programme</h2>
        <form action="/programme/edit/<%= programme.id %>" method="POST" enctype="multipart/form-data"
            class="mx-auto">
            <div class="mb-3">
                <label for="description" class="form-label">Description</label>
                <input type="text" class="form-control" name="description" id="description"
                    value="<%= programme.description %>" required>
            </div>
            <div class="mb-3">
                <label for="startDate" class="form-label">Start Date</label>
                <input type="date" class="form-control" name="startDate" id="startDate"
                    value="<%= programme.startDate %>" required>
            </div>
            <div class="mb-3">
                <label for="endDate" class="form-label">End Date</label>
                <input type="date" class="form-control" name="endDate" id="endDate" value="<%= programme.endDate %>"
                    required>
            </div>
            <div class="mb-3">
                <label for="location" class="form-label">Location</label>
                <input type="text" class="form-control" name="location" id="location" value="<%= programme.location %>"
                    required>
            </div>
            <div class="mb-3">
                <label for="image">Current Image:</label><br>
                <input type="'text" name="currentImage" value=<%=programme.image%>readonly><br>
                <img src="/images/<%= programme.image %>" width="40%"><br><br>

                New Image: <br><input type="file" id="image" name="image" accept="image/*" value=<%=programme.image%>><br><br>
            </div>
            <div class="text-center">
        <button type="submit" class="btn btn-primary">Edit Programme</button>
        <a href="/programme_j" class="btn btn-secondary ms-2">Cancel</a>
        </form>
    </div>

</body>

</html>
