<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <title>Edit Pet Food</title>
</head>

<body>
  <nav class="navbar navbar-expand-sm bg-dark navbar-dark">
    <div class="container-fluid">
      <a class="navbar-brand" href="/petFoodList">Pet Hotel</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#collapsibleNavbar">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="collapsibleNavbar">
        <ul class="navbar-nav">
          <li class="nav-item">
            <a class="nav-link" href="/addPetFood">Add New Food</a>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <div class="container">
    <br>
    <div class="text-center">
      <h2>Update Pet Food</h2>
    </div>
    <br>
    <div class="text-center">
      <% if (food) { %>
        <form action="/editPetFood/<%= food.foodId %>" method="POST" enctype="multipart/form-data">
          <label for="name">Food Name:</label><br>
          <input type="text" id="name" name="name" value="<%= food.name %>" required><br><br>

          <label for="category">Category:</label><br>
          <input type="text" id="category" name="category" value="<%= food.category %>" required><br><br>

          <label for="brand">Brand:</label><br>
          <input type="text" id="brand" name="brand" value="<%= food.brand %>" required><br><br>

          <label for="ingredients">Ingredients:</label><br>
          <textarea id="ingredients" name="ingredients" rows="3" required><%= food.ingredients %></textarea><br><br>

          <label for="image">Current Image:</label><br>
          <input type="text" name="currentImage" value="<%= food.image %>" readonly><br>
          <img src="/images/<%= food.image %>" width="20%"><br><br>

          New Image:<br> <input type="file" id="image" name="image" accept="image/*"><br><br>

          <button type="submit">Update Food</button>
        </form>
      <% } else { %>
        <p>No food item found.</p>
      <% } %>
      <a href="/petFoodList">Back</a>
    </div>
  </div>
</body>

</html>
