<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <title>Pet Hotel</title>
</head>
<body>
    <nav class="navbar navbar-expand-sm bg-dark navbar-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="/petHotel">Pet Hotel</a>
        </div>
    </nav>
    <div class="container">
      <br>
      <div class="text-center">
        <h2>Pet's Appointment Details</h2>
      </div>
      <br>
      <% if (pet) { %>
        <div>
          <p><b>Customer Name:</b><br>
            <%= pet.customer_name %>
          </p>
          <p><b>Pet Name:</b><br>
            <%= pet.pet_name %>
          </p>
          <p><b>Pet Image:</b><br> <img src="<%= pet.image %>" width="20%"></p>
          <p><b>Start Date:</b><br>
            <%= pet.start_date %>
          </p>
          <p><b>End Date:</b><br>
            <%= pet.end_date %>
          </p>
        </div>
        <% } else { %>
          <p>No pet found</p>
          <% } %>
          <p class="mx-auto p-2"><a class="btn btn-secondary btn-sm" href="/petHotel" role="button">Back</a></p>
    </div>
</body>
</html>
