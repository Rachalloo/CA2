<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Add Partnership</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>
    nav class="navbar navbar-expand-sm bg-dark navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="/">Pet Council Pharmacy</a>
        <ul class="navbar-nav">
            <li class="nav-item">
                <a class="nav-link" href="/partnership">Back to Partnership</a>
            </li>
        </ul>
    </div>
    </nav>

    <div class="container mt-5">
        <h2 class="text-center mb-4">Add New Partnership</h2>
        <form action="/partnership/add" method="POST" enctype="multipart/form-data" class="mx-auto">
            <div class="mb-3">
                <label for="name" class="form-label">Partner Name</label>
                <input type="text" class="form-control" id="name" name="name" required>
            </div>

            <div class="mb-3">
                <label for="contact" class="form-label">Contact Number</label>
                <input type="text" class="form-control" id="contact" name="contact" required>
            </div>

            <div class="mb-3">
                <label for="email" class="form-label">Email Address</label>
                <input type="email" class="form-control" id="email" name="email" required>
            </div>

            <div class="mb-3">
                <label for="image" class="form-label">Image</label>
                <input type="file" class="form-control" id="image" name="image" required>
            </div>

            <div class="text-center">
                <button type="submit" class="btn btn-primary">Add Partnership</button>
                <a href="/partnership" class="btn btn-secondary ms-2">Cancel</a>
            </div>
        </form>
    </div>

</body>

</html>